<aside class="sidebar" id="sidebar">
  <a class="brand" href="/" aria-label="VoxSekai — главная"
    ><span class="soundmark"><i></i><i></i><i></i><i></i></span
    ><span>voxsekai</span></a
  >
  <nav class="primary-nav" aria-label="Основная навигация">
    <a class="nav-link <%= currentPath === '/' ? 'active' : '' %>" href="/"
      ><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m3.5 10 8.5-7 8.5 7v10a1 1 0 0 1-1 1h-15a1 1 0 0 1-1-1z"/><path d="M9 21v-7h6v7"/></svg>Главная</a
    >
    <a
      class="nav-link <%= currentPath === '/catalog' ? 'active' : '' %>"
      href="/catalog"
      ><span class="nav-icon">♫</span>Треки</a
    >
    <a
      class="nav-link <%= currentPath === '/artists' ? 'active' : '' %>"
      href="/artists"
      ><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20v-1.5A5.5 5.5 0 0 1 8 13h2a5.5 5.5 0 0 1 5.5 5.5V20z"/><path d="M16 4.8a3.5 3.5 0 0 1 0 6.4M18 13.4a5.5 5.5 0 0 1 3.5 5.1V20h-3"/></svg>Исполнители</a
    >
    <a
      class="nav-link <%= currentPath === '/collections' ? 'active' : '' %>"
      href="/collections"
      ><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="4" width="14" height="14" rx="2"/><path d="M7 8h7M7 11h7"/><path d="M7 20h11a2 2 0 0 0 2-2V7"/></svg>Подборки</a
    >
    <a
      class="nav-link <%= currentPath === '/events' ? 'active' : '' %>"
      href="/events"
      ><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="16" rx="2"/><path d="M7.5 3v4M16.5 3v4M3.5 10h17M8 14h3v3H8z"/><path d="m16.5 13 .6 1.4 1.4.6-1.4.6-.6 1.4-.6-1.4-1.4-.6 1.4-.6z"/></svg>События</a
    >
  </nav>
  <% if (currentUser) { %>
  <div class="side-collection">
    <p class="side-label">МОЯ МУЗЫКА</p>
    <a
      class="side-link <%= currentPath === '/playlists' || currentPath === '/create-playlist' ? 'active' : '' %>"
      href="/playlists"
      ><span>☷</span>Мои плейлисты</a
    >
    <a class="side-link <%= currentPath === '/favorites' ? 'active' : '' %>" href="/favorites"><span>♡</span>Избранное</a>
    <a
      class="side-link <%= currentPath === '/profile' ? 'active' : '' %>"
      href="/profile"
      ><span><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M4.5 21v-1.5A6.5 6.5 0 0 1 11 13h2a6.5 6.5 0 0 1 6.5 6.5V21z"/></svg></span>Профиль</a
    >
    <div class="side-divider"></div>
    <a class="create-playlist" href="/create-playlist"
      >＋ Создать плейлист</a
    >
  </div>
  <% } else { %>
  <div class="side-collection side-collection-locked">
    <p class="side-label">МОЯ МУЗЫКА</p>
    <p class="side-lock-note">
      Войди в аккаунт, чтобы открыть плейлисты, избранное и профиль.
    </p>
    <a class="side-lock-link" href="/login?next=%2Fprofile"
      >Войти в аккаунт <span>↗</span></a
    >
  </div>
  <% } %>
  <div class="sidebar-about">
    <% if (currentUser) { %>
    <p class="sidebar-user">Привет, <%= currentUser.username %></p>
    <span>Твой музыкальный профиль подключён.</span>
    <a href="/profile">Профиль ↗</a>
    <form method="post" action="/logout" class="sidebar-logout-form">
      <button type="submit" class="sidebar-logout">Выйти</button>
    </form>
    <% } else { %>
    <p>Твой голос. Твой мир.</p>
    <span>Всё бесплатно.<br />Без подписок.</span
    ><a href="/login">Войти ↗</a>
    <a href="/register">Создать аккаунт</a>
    <% } %>
  </div>
</aside>
