<header class="topbar">
  <% if (showMenuToggle !== false) { %>
  <button
    class="mobile-menu icon-button"
    id="menu-toggle"
    aria-label="Открыть меню"
  >
    ☰
  </button>
  <% } %>
  <label class="search-box">
    <span aria-hidden="true">⌕</span>
    <input
      id="site-search"
      type="search"
      placeholder="Трек, продюсер или виртуальный голос"
      aria-label="<%= searchLabel || 'Поиск по сайту' %>"
    />
    <kbd>Ctrl K</kbd>
  </label>
  <div class="account-actions">
    <% if (currentUser) { %>
    <a class="account-chip" href="/profile" aria-label="Открыть профиль">
      <span class="avatar"><%= currentUser.username.charAt(0).toUpperCase() %></span>
      <span class="account-chip-copy">
        <strong><%= currentUser.username %></strong>
        <small>Мой аккаунт</small>
      </span>
    </a>
    <form class="logout-form" method="post" action="/logout">
      <button class="auth-header-link auth-header-link-logout" type="submit">Выйти</button>
    </form>
    <% } else { %>
    <a class="auth-header-link" href="/login">Войти</a>
    <a class="auth-header-link auth-header-link-primary" href="/register">Регистрация</a>
    <% } %>
  </div>
</header>
