<section
  class="global-player"
  id="global-player"
  aria-label="Музыкальный плеер"
  aria-hidden="true"
  hidden
>
  <div class="player-progress">
    <span class="player-time" data-player-current>0:00</span>
    <input
      class="player-seek"
      data-player-seek
      type="range"
      min="0"
      max="100"
      value="0"
      aria-label="Позиция воспроизведения"
    />
    <span class="player-progress-wave" aria-hidden="true">
      <% for (let index = 0; index < 36; index += 1) { %>
        <i style="--wave-height: <%= 18 + ((index * 41) % 76) %>%; --wave-delay: -<%= ((index * 7) % 60) / 100 %>s"></i>
      <% } %>
    </span>
    <span class="player-time" data-player-duration>0:00</span>
  </div>
  <div class="player-main">
    <a class="player-track" data-player-details href="/catalog">
      <span class="player-artwork artwork-cyan" data-player-artwork
        ><img class="player-artwork-photo" data-player-image alt="" hidden /><span data-player-glyph>音</span></span
      >
      <span class="player-track-copy">
        <strong data-player-title>Трек</strong>
        <span data-player-artist>Исполнитель</span>
        <small class="player-track-status" data-player-status
          >Демо · аудио не подключено</small
        >
      </span>
    </a>
    <div class="player-controls">
      <button
        class="player-control"
        data-player-action="previous"
        type="button"
        aria-label="Предыдущий трек"
        title="Предыдущий трек"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M6 5h2v14H6zM19 6.5v11a.8.8 0 0 1-1.24.67l-8.4-5.5a.8.8 0 0 1 0-1.34l8.4-5.5A.8.8 0 0 1 19 6.5z" />
        </svg>
      </button>
      <button
        class="player-control player-toggle"
        data-player-action="toggle"
        type="button"
        aria-label="Пауза"
        title="Пауза"
      >
        <span class="player-toggle-icon" aria-hidden="true" data-player-toggle-icon>
          <svg viewBox="0 0 24 24" focusable="false">
            <path data-toggle-play d="M8.2 5.8a1 1 0 0 1 1.5-.86l9.1 6.2a1.03 1.03 0 0 1 0 1.72l-9.1 6.2a1 1 0 0 1-1.5-.86z" />
            <g data-toggle-pause>
              <rect x="6.5" y="5" width="4.5" height="14" rx="1.4" />
              <rect x="13" y="5" width="4.5" height="14" rx="1.4" />
            </g>
          </svg>
        </span>
      </button>
      <button
        class="player-control"
        data-player-action="next"
        type="button"
        aria-label="Следующий трек"
        title="Следующий трек"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M16 5h2v14h-2zM5 6.5v11a.8.8 0 0 0 1.24.67l8.4-5.5a.8.8 0 0 0 0-1.34l-8.4-5.5A.8.8 0 0 0 5 6.5z" />
        </svg>
      </button>
    </div>
    <div class="player-extras">
      <a
        class="player-extra"
        data-player-details
        href="/catalog"
        aria-label="Подробнее о треке"
        title="Подробнее о треке"
        >ⓘ</a
      >
      <label class="player-volume" aria-label="Громкость">
        <input
          data-player-volume
          type="range"
          min="0"
          max="1"
          step="0.01"
          value="0.7"
          aria-label="Громкость"
        />
      </label>
      <button
        class="player-control player-dismiss"
        data-player-action="dismiss"
        type="button"
        aria-label="Скрыть плеер"
        title="Скрыть плеер"
      >
        ×
      </button>
    </div>
  </div>
  <audio data-player-audio preload="none"></audio>
</section>
<script type="application/json" id="track-catalog"><%- JSON.stringify(trackCatalog).replace(/</g, '\\u003c') %></script>
