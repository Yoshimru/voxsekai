<article class="track-card track-row" data-track-id="<%= track.id %>" data-favorite-item="<%= track.id %>" data-genre-item data-genre="<%= track.filterGenre %>" data-search-text="<%= `${track.displayTitle} ${track.title} ${track.artist} ${track.genre}`.toLocaleLowerCase('ru') %>" data-track-slug="<%= track.id %>" data-track-title="<%= track.displayTitle %>" data-track-original-title="<%= track.title %>" data-track-artist="<%= track.artist %>" data-track-duration="<%= track.duration %>" data-track-genre="<%= track.genre %>" data-track-artwork="<%= track.artworkClass %>" data-track-glyph="<%= track.artworkGlyph %>" data-track-image="<%= track.imageUrl || '' %>" data-track-audio="<%= track.audioUrl || '' %>">
  <a class="mini-cover <%= track.artworkClass %> <%= track.imageUrl ? 'has-photo' : '' %>" href="/track/<%= track.id %>" aria-label="Подробнее о треке <%= track.displayTitle %>">
    <% if (track.imageUrl) { %>
      <img class="mini-cover-photo" src="<%= track.imageUrl %>" alt="<%= track.displayTitle %>" loading="lazy" onerror="this.parentElement.classList.remove('has-photo');this.remove()" />
    <% } %>
    <span class="mini-cover-glyph"><%= track.artworkGlyph %></span>
    <span class="track-playing-indicator" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
  </a>
  <div class="track-row-info">
    <h3><a href="/track/<%= track.id %>"><%= track.displayTitle %></a></h3>
    <p><%= track.artist %></p>
  </div>
  <span class="track-row-tag"><%= track.genre %></span>
  <span class="track-row-duration"><%= Math.floor(track.duration / 60) %>:<%= String(track.duration % 60).padStart(2, '0') %></span>
  <button class="play-button" type="button" data-player-play aria-label="Воспроизвести <%= track.displayTitle %>" aria-pressed="false">
    <span class="track-play-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path data-toggle-play d="M8.2 5.8a1 1 0 0 1 1.5-.86l9.1 6.2a1.03 1.03 0 0 1 0 1.72l-9.1 6.2a1 1 0 0 1-1.5-.86z"/><g data-toggle-pause><rect x="6.5" y="5" width="4.5" height="14" rx="1.4"/><rect x="13" y="5" width="4.5" height="14" rx="1.4"/></g></svg></span>
  </button>
  <button class="like-button" type="button" data-favorite-track="<%= track.id %>" aria-label="Добавить <%= track.displayTitle %> в избранное" aria-pressed="false">♡</button>
</article>
