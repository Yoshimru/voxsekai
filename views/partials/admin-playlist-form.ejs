<%
  const currentPlaylist = typeof playlist !== 'undefined' && playlist ? playlist : null;
  const selectedStyle = currentPlaylist?.style?.id || cardStyles[0]?.id || '';
  const selectedTracks = currentPlaylist?.trackIds || [];
%>
<form method="post" action="<%= formAction %>">
  <div class="admin-form">
    <label>Название<span><input type="text" name="title" maxlength="150" value="<%= currentPlaylist?.title || '' %>" required /></span></label>
    <label>Подпись (label)<span><input type="text" name="label" maxlength="100" value="<%= currentPlaylist?.label || '' %>" placeholder="ON REPEAT" /></span></label>
    <div class="admin-style-field is-wide">
      <span class="admin-form-label">Стиль обложки плейлиста</span>
      <div class="admin-cover-style-grid">
        <% cardStyles.forEach((style) => { %>
          <label class="admin-cover-style-option">
            <input type="radio" name="artworkClass" value="<%= style.id %>" <%= selectedStyle === style.id ? 'checked' : '' %> required />
            <span class="admin-cover-style-preview" style="background: <%= style.background %>;">
              <span class="admin-cover-style-glyph"><%= style.glyph %></span>
              <span class="admin-cover-style-name"><%= style.name %></span>
            </span>
          </label>
        <% }) %>
      </div>
    </div>
    <label class="is-wide">Описание<span><textarea name="description" rows="3" maxlength="1000"><%= currentPlaylist?.description || '' %></textarea></span></label>
    <label class="checkbox-row">
      <input type="checkbox" name="isPublic" <%= !currentPlaylist || currentPlaylist.isPublic ? 'checked' : '' %> />
      Публичный плейлист
    </label>
    <label class="is-wide">Треки плейлиста
      <span class="admin-track-picker">
        <% tracks.forEach((track) => { %>
          <label>
            <input type="checkbox" name="trackIds" value="<%= track.id %>" <%= selectedTracks.includes(track.id) ? 'checked' : '' %> />
            <%= track.displayTitle %> · <%= track.artistName %>
          </label>
        <% }) %>
      </span>
    </label>
    <div class="admin-actions">
      <button class="admin-button" type="submit"><%= submitLabel %></button>
      <% if (currentPlaylist) { %><a class="admin-button admin-button-secondary" href="/admin/playlists">Отмена</a><% } %>
    </div>
  </div>
</form>
