<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0e1014" />
    <meta name="description" content="VoxSekai — твой мир виртуальной музыки." />
    <title><%= title %></title>
    <link rel="stylesheet" href="/assets/css/base.css" />
    <link rel="stylesheet" href="/assets/css/shared-layout.css" />
    <link rel="stylesheet" href="/assets/css/home.css" />
    <link rel="stylesheet" href="/assets/css/player.css" />
    <script src="/assets/js/main.js" defer></script>
  </head>
  <body>
    <div class="app-shell">
      <%- include('partials/sidebar', { currentPath: '/' }) %>
      <main class="main-area">
        <%- include('partials/topbar', { searchLabel: 'Поиск', showMenuToggle: true }) %>
        <div class="content home-content">
          <div class="page-heading"><h1>Твой мир звучит по-новому</h1><p>Главная <span>/</span> Для тебя</p></div>
          <section class="hero-feature" aria-label="Персональная подборка">
            <img class="hero-feature-image" src="https://images.unsplash.com/photo-1516280440614-37939bbacd81?auto=format&fit=crop&w=1800&q=85" alt="" />
            <div class="hero-feature-shade"></div>
            <div class="hero-feature-copy">
              <p class="eyebrow"><span>✦</span> ВЫБОР РЕДАКЦИИ · VOXSEKAI</p>
              <p class="hero-feature-kicker">ПЕРСОНАЛЬНАЯ ПОДБОРКА</p>
              <h2>За пределами<br />реального голоса</h2>
              <p class="hero-feature-description">Музыка, в которой живут новые миры. Начни с любимого голоса и найди звучание, которого ещё не слышал.</p>
              <div class="hero-feature-actions"><a class="button button-primary" href="/collections">Открыть подборку <span>↗</span></a><span class="hero-feature-meta"><%= tracks.length %> треков в каталоге</span></div>
            </div>
            <span class="hero-feature-count">01 <i></i> 04</span>
          </section>
          <section class="genre-filter" aria-label="Фильтр по жанру">
            <button class="genre-chip active" type="button" data-filter="all" aria-pressed="true">Все жанры</button>
            <button class="genre-chip" type="button" data-filter="j-pop" aria-pressed="false">J-pop</button>
            <button class="genre-chip" type="button" data-filter="electronic" aria-pressed="false">Электроника</button>
            <button class="genre-chip" type="button" data-filter="rock" aria-pressed="false">Рок</button>
            <button class="genre-chip" type="button" data-filter="dance" aria-pressed="false">Dance</button>
            <button class="genre-chip" type="button" data-filter="ambient" aria-pressed="false">Эмбиент</button>
            <span class="genre-filter-note">Обновлено сегодня</span>
          </section>
          <section class="section-block taste-section">
            <div class="section-heading">
              <div><p class="eyebrow muted">ПОДБОРКА ДЛЯ ТЕБЯ</p><h2>Попадание в твой вкус</h2><p class="section-subtitle">Треки, которые могут стать твоими любимыми</p></div>
              <a href="/catalog" class="view-all">Все рекомендации <span>↗</span></a>
            </div>
            <div class="taste-layout">
              <div class="track-list recommendation-track-list" aria-label="Рекомендованные треки">
                <% if (tracks.length) { %>
                  <% tracks.forEach((track) => { %>
                    <%- include('partials/track-row', { track }) %>
                  <% }) %>
                <% } else { %>
                  <div class="recommendation-empty">
                    <span aria-hidden="true">♫</span>
                    <p>Пока нет рекомендаций. Добавь треки в каталог — здесь появятся подборки для тебя.</p>
                    <a class="view-all" href="/catalog">Открыть каталог <span>↗</span></a>
                  </div>
                <% } %>
              </div>
              <aside class="taste-card" data-taste-card aria-label="Жанр недели">
                <div class="taste-card-heading"><span class="taste-card-mark">≋</span><span>ТВОЙ ЖАНР НЕДЕЛИ</span></div>
                <% if (taste.hasData) { %>
                <h3><span data-taste-genre><%= taste.genre %></span><br />с характером</h3>
                <p data-taste-description><%= taste.description %></p>
                <div class="taste-meter"><span style="--level: <%= taste.percent %>%" data-taste-meter></span></div>
                <div class="taste-meter-label"><span data-taste-genre-label><%= taste.genre %></span><b data-taste-percent><%= taste.percent %>%</b></div>
                <div class="taste-card-meta"><span data-taste-count><%= taste.count %></span> треков в этом жанре</div>
                <a class="taste-card-link" href="/catalog?genre=<%= taste.filter %>" data-taste-link>Исследовать жанр <span>↗</span></a>
                <% } else { %>
                <h3>Жанр ещё<br />не определён</h3>
                <p>Добавь треки в избранное — и мы поймём, что звучит у тебя чаще.</p>
                <a class="taste-card-link" href="/catalog" data-taste-link>Открыть каталог <span>↗</span></a>
                <% } %>
              </aside>
            </div>
          </section>
          <section class="home-lower-grid">
            <div class="section-block home-collection-section">
              <div class="section-heading"><div><p class="eyebrow muted">ТВОЯ МУЗЫКА</p><h2>Твоя коллекция</h2></div><a href="/playlists" class="view-all">Мои плейлисты <span>↗</span></a></div>
              <div class="collection-grid">
                <a class="collection-tile collection-favorites" href="/favorites"><span class="collection-icon">♡</span><span class="collection-arrow">↗</span><strong>Самое любимое</strong><small>Твои сохранённые треки</small></a>
                <a class="collection-tile collection-repeat" href="/playlists"><span class="collection-icon collection-wave">≋</span><span class="collection-arrow">↗</span><strong>На повторе</strong><small>Недавно прослушанное</small></a>
              </div>
              <a href="/create-playlist" class="create-collection">＋ Создать новую подборку</a>
            </div>
            <div class="section-block event-section">
              <div class="section-heading"><div><p class="eyebrow muted">ВСТРЕЧАЕМСЯ ВЖИВУЮ</p><h2>За пределами наушников</h2></div><a href="/events" class="view-all">Все события <span>↗</span></a></div>
              <div class="event-list">
                <% events.slice(0, 2).forEach((event) => { %>
                  <a class="event-row" href="/events/<%= event.id %>">
                    <span class="event-date"><b><%= event.day %></b><small><%= event.month %></small></span>
                    <span class="event-info"><strong><%= event.title %></strong><small><%= event.location %> · Начало в <%= event.time %></small></span>
                    <span class="event-status">СКОРО</span>
                  </a>
                <% }) %>
              </div>
              <p class="event-note">Добавь событие в календарь, чтобы не пропустить.</p>
            </div>
          </section>
          <%- include('partials/footer', { footerClass: '', footerText: '© 2026 VoxSekai. Музыка объединяет миры.' }) %>
        </div>
      </main>
    </div>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <%- include('partials/mobile-nav', { currentPath: '/' }) %>
    <%- include('partials/player') %>
  </body>
</html>
