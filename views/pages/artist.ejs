<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0e1014" />
    <meta name="description" content="Треки исполнителя <%= artist.name %> в VoxSekai." />
    <title><%= title %></title>
    <link rel="stylesheet" href="/assets/css/base.css" />
    <link rel="stylesheet" href="/assets/css/shared-layout.css" />
    <link rel="stylesheet" href="/assets/css/directory.css" />
    <link rel="stylesheet" href="/assets/css/player.css" />
    <script src="/assets/js/main.js" defer></script>
  </head>
  <body class="directory-page artist-detail-page">
    <div class="app-shell">
      <%- include('../partials/sidebar', { currentPath: '/artists' }) %>
      <main class="main-area">
        <%- include('../partials/topbar', { searchLabel: 'Поиск по сайту', showMenuToggle: true }) %>
        <div class="content directory-content artist-detail-content">
          <a class="track-back-link" href="/artists">← Все исполнители</a>
          <section class="artist-detail-hero <%= artist.cardClass %>" style="--performer-accent: <%= artist.style.accent %>; --performer-background: <%= artist.style.background %>;">
            <div class="artist-detail-art <%= artist.imageUrl ? 'has-photo' : '' %>">
              <% if (artist.imageUrl) { %>
                <img class="artist-detail-photo" src="<%= artist.imageUrl %>" alt="<%= artist.name %>" onerror="this.parentElement.classList.remove('has-photo');this.remove()" />
              <% } %>
              <span class="performer-bars"><i></i><i></i><i></i><i></i><i></i></span><b><%= artist.initials %></b>
            </div>
            <div class="artist-detail-copy">
              <p class="directory-kicker"><%= artist.genreLabel %></p>
              <h1><%= artist.name %></h1>
              <p><%= artist.alias %> · <%= artist.country %></p>
              <span><%= tracks.length %> треков в каталоге VoxSekai</span>
            </div>
          </section>
          <section class="artist-track-section" aria-labelledby="artist-tracks-heading">
            <div class="directory-section-heading">
              <h2 id="artist-tracks-heading">Треки исполнителя</h2>
              <p><%= tracks.length %> <%= tracks.length === 1 ? 'трек' : 'треков' %></p>
            </div>
            <% if (tracks.length) { %>
              <div class="recent-track-list" data-player-queue>
                <% tracks.forEach((track) => { %>
                  <%- include('../partials/track-row', { track }) %>
                <% }) %>
              </div>
            <% } else { %>
              <div class="artist-empty-state">
                <span aria-hidden="true">♫</span>
                <h3>Треки скоро появятся</h3>
                <p>Мы добавим релизы этого исполнителя в каталог.</p>
                <a class="button button-secondary" href="/catalog">Перейти в каталог</a>
              </div>
            <% } %>
          </section>
          <%- include('../partials/footer', { footerClass: 'directory-footer', footerText: '© 2026 VoxSekai · Музыка начинается с тебя' }) %>
        </div>
      </main>
    </div>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <%- include('../partials/mobile-nav', { currentPath: '/artists' }) %>
    <%- include('../partials/player') %>
  </body>
</html>
