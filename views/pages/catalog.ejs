<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0e1014" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/assets/css/base.css" />
    <link rel="stylesheet" href="/assets/css/shared-layout.css" />
    <link rel="stylesheet" href="/assets/css/directory.css" />
    <link rel="stylesheet" href="/assets/css/player.css" />
    <script src="/assets/js/main.js" defer></script>
  </head>
  <body class="directory-page catalog-page">
    <div class="app-shell">
      <%- include('../partials/sidebar', { currentPath: '/catalog' }) %>
      <main class="main-area">
        <%- include('../partials/topbar', { searchLabel: 'Поиск по сайту', showMenuToggle: true }) %>
        <div class="content directory-content">
          <header class="directory-heading">
            <div>
              <p class="directory-kicker">DISCOVER / 01</p>
              <h1><%= collection ? collection.title : 'Каталог музыки' %></h1>
              <p><%= collection ? collection.description : 'Найди следующий трек, который попадёт в настроение.' %></p>
            </div>
          </header>
          <section class="catalog-controls" aria-label="Поиск и сортировка каталога">
            <label class="directory-search"><span aria-hidden="true">⌕</span><input id="page-search" type="search" placeholder="Трек, исполнитель, жанр или настроение" aria-label="Поиск в каталоге" /></label>
            <label class="sort-control"><span class="sr-only">Сортировка</span><select id="catalog-sort">
              <option value="popular">Популярное</option><option value="rating">По рейтингу</option><option value="title">По названию</option>
            </select></label>
            <button class="filter-control" type="button" data-filter-toggle aria-expanded="false" aria-controls="catalog-genres" aria-label="Показать фильтры" title="Фильтры">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 5h16l-6.2 7.1v5.2l-3.6 1.8v-7z" /></svg>
            </button>
          </section>
          <section class="directory-genres" id="catalog-genres" aria-label="Жанры" hidden>
            <p class="directory-label">ЖАНРЫ</p>
            <div class="genre-filter">
              <button class="genre-chip active" type="button" data-filter="all" aria-pressed="true">Все треки</button>
              <button class="genre-chip" type="button" data-filter="electronic" aria-pressed="false">Электроника</button>
              <button class="genre-chip" type="button" data-filter="j-pop" aria-pressed="false">J-pop</button>
              <button class="genre-chip" type="button" data-filter="synthwave" aria-pressed="false">Синтвейв</button>
              <button class="genre-chip" type="button" data-filter="ambient" aria-pressed="false">Эмбиент</button>
              <button class="genre-chip" type="button" data-filter="rock" aria-pressed="false">Рок</button>
              <button class="genre-chip" type="button" data-filter="dance" aria-pressed="false">Dance</button>
            </div>
          </section>
          <% if (featuredCollection) { %>
          <section class="catalog-feature" aria-label="Подборка недели">
            <div class="catalog-feature-art"><span class="catalog-feature-wave" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span><span><%= featuredCollection.tagline %></span></div>
            <div class="catalog-feature-copy"><p class="eyebrow">ПОДБОРКА НЕДЕЛИ</p><h2><%= featuredCollection.title %></h2><p><%= featuredCollection.description %></p><small><%= featuredCollection.trackCount %> треков в подборке</small></div>
            <a class="button button-primary" href="/catalog?collection=<%= featuredCollection.id %>">Слушать подборку <span>↗</span></a>
          </section>
          <% } %>
          <section class="catalog-tracks">
            <div class="directory-section-heading"><h2>Треки для твоего следующего вайба</h2><p><span data-results-count><%= tracks.length %></span> треков · сортировка по популярности</p></div>
            <div class="catalog-track-grid" data-sort-list>
              <% tracks.forEach((track) => { %>
                <%- include('../partials/track-card', { track }) %>
              <% }) %>
            </div>
            <p class="directory-empty" hidden>Треки не найдены.</p>
          </section>
          <%- include('../partials/footer', { footerClass: 'directory-footer', footerText: '© 2026 VoxSekai · Музыка начинается с тебя' }) %>
        </div>
      </main>
    </div>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <%- include('../partials/mobile-nav', { currentPath: '/catalog' }) %>
    <%- include('../partials/player') %>
  </body>
</html>
