<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/assets/css/admin.css" />
  </head>
  <body class="admin-body">
    <%- include('../../partials/admin-header', { adminUser, section, basePath: '/admin' }) %>
    <div class="admin-heading">
      <h1>Подборки <%= collections.length ? '(' + collections.length + ')' : '' %></h1>
      <p>Одна из подборок может быть «подборкой недели» — она показывается на каталоге и главной странице подборок.</p>
    </div>
    <div class="admin-panel">
      <h2>Новая подборка</h2>
      <% if (error) { %><p class="admin-error" role="alert"><%= error %></p><% } %>
      <%- include('../../partials/collection-form', {
        formAction: '/admin/collections',
        collection: null,
        tracks,
        cardStyles,
        submitLabel: 'Создать подборку',
      }) %>
    </div>
    <div class="admin-panel">
      <h2>Все подборки</h2>
      <% if (collections.length) { %>
        <table class="admin-table">
          <thead>
            <tr><th>Название</th><th>Подпись</th><th>Треков</th><th>Неделя</th><th>Состав</th><th></th></tr>
          </thead>
          <tbody>
            <% collections.forEach((collection) => { %>
              <tr>
                <td><b><%= collection.title %></b> <small style="color:var(--admin-muted)"><%= collection.id %></small></td>
                <td><%= collection.tagline %></td>
                <td><%= collection.trackCount %></td>
                <td><%= collection.featured ? '★' : '' %></td>
                <td class="admin-muted"><%= collection.trackIds.join(', ') || '—' %></td>
                <td>
                  <div class="admin-row-actions">
                    <a class="admin-button admin-button-secondary admin-button-small" href="/admin/collections/<%= collection.id %>/edit">Редактировать</a>
                    <form method="post" action="/admin/collections/<%= collection.id %>/delete" style="margin:0" onsubmit="return confirm('Удалить подборку?')">
                      <button class="admin-button-danger" type="submit">Удалить</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <p style="color:var(--admin-muted)">Подборок пока нет. Создайте первую — она появится на сайте сразу.</p>
      <% } %>
    </div>
    <%- include('../../partials/admin-footer') %>
  </body>
</html>
