<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/assets/css/directory.css" />
    <link rel="stylesheet" href="/assets/css/admin.css" />
  </head>
  <body class="admin-body">
    <%- include('../../partials/admin-header', { adminUser, section, basePath: '/admin' }) %>
    <div class="admin-heading">
      <h1>Исполнители <%= artists.length ? '(' + artists.length + ')' : '' %></h1>
      <p>Исполнители связаны с треками через таблицу artist_tracks. Количество треков считается автоматически, когда вы добавляете трек и выбираете исполнителя.</p>
    </div>
    <div class="admin-panel">
      <h2>Новый исполнитель</h2>
      <% if (error) { %>
        <p class="admin-error" role="alert"><%= error %></p>
      <% } %>
      <%- include('../../partials/artist-form', {
        formAction: '/admin/artists',
        artist: null,
        cardStyles,
        submitLabel: 'Добавить исполнителя',
      }) %>
    </div>
    <div class="admin-panel">
      <h2>Все исполнители</h2>
      <% if (artists.length) { %>
        <table class="admin-table admin-table-entities">
          <thead>
            <tr><th></th><th>Имя</th><th>Стиль</th><th>Жанр</th><th>Страна</th><th>Треков</th><th></th></tr>
          </thead>
          <tbody>
            <% artists.forEach((artist) => { %>
              <tr>
                <td>
                  <span class="admin-thumb <%= artist.cardClass %>">
                    <% if (artist.imageUrl) { %>
                      <img src="<%= artist.imageUrl %>" alt="<%= artist.name %>" />
                    <% } else { %>
                      <b><%= artist.initials || '—' %></b>
                    <% } %>
                  </span>
                </td>
                <td>
                  <b><%= artist.name %></b>
                  <small class="admin-muted"><%= artist.id %></small>
                </td>
                <td><span class="admin-style-tag <%= artist.cardClass %>"><%= artist.cardClass || '—' %></span></td>
                <td><%= artist.genreLabel %></td>
                <td><%= artist.country %></td>
                <td><%= artist.trackCount %></td>
                <td>
                  <div class="admin-row-actions">
                    <a class="admin-button admin-button-secondary admin-button-small" href="/admin/artists/<%= artist.id %>/edit">Редактировать</a>
                    <form method="post" action="/admin/artists/<%= artist.id %>/delete" onsubmit="return confirm('Удалить исполнителя?')">
                      <button class="admin-button-danger" type="submit">Удалить</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <p class="admin-muted">Исполнителей пока нет.</p>
      <% } %>
    </div>
    <%- include('../../partials/admin-footer') %>
  </body>
</html>
