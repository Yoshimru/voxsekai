<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/assets/css/admin.css" />
  </head>
  <body class="admin-body">
    <%- include('../../partials/admin-header', { adminUser, section, basePath: '/admin' }) %>
    <div class="admin-heading">
      <h1>Плейлисты <%= playlists.length ? '(' + playlists.length + ')' : '' %></h1>
      <p>Публичные плейлисты видны в разделе «Открытые плейлисты».</p>
    </div>
    <div class="admin-panel">
      <h2>Новый плейлист</h2>
      <form method="post" action="/admin/playlists">
        <div class="admin-form">
          <label>Название<span><input type="text" name="title" required /></span></label>
          <label>Подпись (label)<span><input type="text" name="label" placeholder="ON REPEAT" /></span></label>
          <label>Стиль обложки<span>
            <select name="artworkClass">
              <option value="playlist-card-new">playlist-card-new</option>
              <option value="playlist-card-night">playlist-card-night</option>
              <option value="playlist-card-repeat">playlist-card-repeat</option>
              <option value="playlist-card-morning">playlist-card-morning</option>
              <option value="playlist-card-drive">playlist-card-drive</option>
            </select>
          </span></label>
          <label class="is-wide">Описание<span><input type="text" name="description" /></span></label>
          <label class="checkbox-row">
            <input type="checkbox" name="isPublic" checked />
            Публичный плейлист
          </label>
          <label class="is-wide">Треки плейлиста
            <span class="admin-track-picker">
              <% tracks.forEach((track) => { %>
                <label>
                  <input type="checkbox" name="trackIds" value="<%= track.id %>" />
                  <%= track.displayTitle %> · <%= track.artistName %>
                </label>
              <% }) %>
            </span>
          </label>
          <div class="admin-actions">
            <button class="admin-button" type="submit">Создать плейлист</button>
          </div>
        </div>
      </form>
    </div>
    <div class="admin-panel">
      <h2>Все плейлисты</h2>
      <% if (playlists.length) { %>
        <table class="admin-table">
          <thead>
            <tr><th>Название</th><th>Открытый</th><th>Треков</th><th>Состав</th><th></th><th></th></tr>
          </thead>
          <tbody>
            <% playlists.forEach((playlist) => { %>
              <tr>
                <td><b><%= playlist.title %></b> <small style="color:var(--admin-muted)"><%= playlist.id %></small></td>
                <td><span class="admin-badge <%= playlist.isPublic ? 'admin-badge-admin' : 'admin-badge-user' %>"><%= playlist.isPublic ? 'публичный' : 'приватный' %></span></td>
                <td><%= playlist.trackCount %></td>
                <td style="color:var(--admin-muted);font-size:12px"><%= playlist.trackIds.join(', ') || '—' %></td>
                <td>
                  <form method="post" action="/admin/playlists/<%= playlist.id %>/tracks" style="margin:0">
                    <details>
                      <summary style="cursor:pointer;color:var(--admin-muted)">Изменить треки</summary>
                      <span class="admin-track-picker" style="margin-top:8px">
                        <% tracks.forEach((track) => { %>
                          <label>
                            <input type="checkbox" name="trackIds" value="<%= track.id %>" <%= playlist.trackIds.includes(track.id) ? 'checked' : '' %> />
                            <%= track.displayTitle %>
                          </label>
                        <% }) %>
                      </span>
                      <button class="admin-button admin-button-secondary" type="submit" style="margin-top:8px">Сохранить треки плейлиста</button>
                    </details>
                  </form>
                </td>
                <td>
                  <form method="post" action="/admin/playlists/<%= playlist.id %>/delete" style="margin:0" onsubmit="return confirm('Удалить плейлист?')">
                    <button class="admin-button-danger" type="submit">Удалить</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <p style="color:var(--admin-muted)">Плейлистов пока нет.</p>
      <% } %>
    </div>
    <%- include('../../partials/admin-footer') %>
  </body>
</html>
