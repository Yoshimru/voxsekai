<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/assets/css/admin.css" />
  </head>
  <body class="admin-body">
    <%- include('../../partials/admin-header', { adminUser, section, basePath: '/admin' }) %>
    <div class="admin-heading">
      <h1>Треки <%= tracks.length ? '(' + tracks.length + ')' : '' %></h1>
      <p>Треки из базы данных напрямую отвечают за каталог, подборки и плейлисты.</p>
    </div>
    <div class="admin-panel">
      <h2>Новый трек</h2>
      <% if (error) { %>
        <p class="admin-error" role="alert"><%= error %></p>
      <% } %>
      <%- include('../../partials/track-form', {
        formAction: '/admin/tracks',
        track: null,
        artists,
        trackStyles,
        selectedArtistId: '',
        submitLabel: 'Добавить трек',
      }) %>
    </div>
    <div class="admin-panel">
      <h2>Все треки</h2>
      <% if (tracks.length) { %>
        <table class="admin-table admin-table-entities">
          <thead>
            <tr><th></th><th>Название</th><th>Исполнитель</th><th>Жанр</th><th>Длит.</th><th>Рейтинг</th><th>Альбом</th><th>Год</th><th></th></tr>
          </thead>
          <tbody>
            <% tracks.forEach((track) => { %>
              <tr>
                <td>
                  <span class="admin-thumb admin-track-thumb" style="background: <%= track.style.background %>;">
                    <% if (track.imageUrl) { %>
                      <img src="<%= track.imageUrl %>" alt="<%= track.displayTitle %>" />
                    <% } else { %>
                      <b><%= track.artworkGlyph %></b>
                    <% } %>
                  </span>
                </td>
                <td>
                  <b><%= track.displayTitle %></b>
                  <small class="admin-muted"><%= track.title %></small>
                </td>
                <td><%= track.artistName %></td>
                <td><%= track.genre %></td>
                <td><%= track.duration %>с</td>
                <td><%= track.rating %></td>
                <td><%= track.album || '—' %></td>
                <td><%= track.releaseYear || '—' %></td>
                <td>
                  <div class="admin-row-actions">
                    <a class="admin-button admin-button-secondary admin-button-small" href="/admin/tracks/<%= track.id %>/edit">Редактировать</a>
                    <form method="post" action="/admin/tracks/<%= track.id %>/delete" onsubmit="return confirm('Удалить трек?')">
                      <button class="admin-button-danger" type="submit">Удалить</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <p class="admin-muted">Треков пока нет. Добавьте первый трек через форму выше.</p>
      <% } %>
    </div>
    <%- include('../../partials/admin-footer') %>
  </body>
</html>
