<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/assets/css/admin.css" />
  </head>
  <body class="admin-body">
    <%- include('../../partials/admin-header', { adminUser, section, basePath: '/admin' }) %>
    <div class="admin-heading">
      <h1>Треки <%= tracks.length ? '(' + tracks.length + ')' : '' %></h1>
      <p>Треки из базы данных напрямую отвечают за каталог, подборки и плейлисты.</p>
    </div>
    <div class="admin-panel">
      <h2>Новый трек</h2>
      <form method="post" action="/admin/tracks">
        <div class="admin-form">
          <label>Название<span><input type="text" name="title" required /></span></label>
          <label>Название для показа<span><input type="text" name="displayTitle" required /></span></label>
          <label>Подпись (artist)<span><input type="text" name="artist" placeholder="author · Vocal" /></span></label>
          <label>Имя исполнителя<span><input type="text" name="artistName" /></span></label>
          <label>Длительность (сек)<span><input type="number" name="duration" min="0" value="200" /></span></label>
          <label>Жанр<span><input type="text" name="genre" /></span></label>
          <label>Рейтинг<span><input type="text" name="rating" placeholder="4.8" /></span></label>
          <label>Альбом<span><input type="text" name="album" /></span></label>
          <label>Год выпуска<span><input type="number" name="releaseYear" min="1900" max="2100" /></span></label>
          <label>Стиль обложки<span>
            <select name="artworkClass">
              <option value="artwork-cyan">artwork-cyan</option>
              <option value="artwork-sakura">artwork-sakura</option>
              <option value="artwork-night">artwork-night</option>
              <option value="artwork-mono">artwork-mono</option>
              <option value="artwork-peach">artwork-peach</option>
              <option value="artwork-violet">artwork-violet</option>
              <option value="artwork-orange">artwork-orange</option>
              <option value="artwork-pink">artwork-pink</option>
            </select>
          </span></label>
          <label>Глиф обложки<span><input type="text" name="artworkGlyph" placeholder="初" /></span></label>
          <label class="is-wide">Ссылка на аудио<span><input type="text" name="audioUrl" placeholder="https://..." /></span></label>
          <label class="is-wide">Описание<span><textarea name="description" rows="2"></textarea></span></label>
          <div class="admin-actions">
            <button class="admin-button" type="submit">Добавить трек</button>
          </div>
        </div>
      </form>
    </div>
    <div class="admin-panel">
      <h2>Все треки</h2>
      <% if (tracks.length) { %>
        <table class="admin-table">
          <thead>
            <tr><th>Название</th><th>Исполнитель</th><th>Жанр</th><th>Длит.</th><th>Рейтинг</th><th>Альбом</th><th>Год</th><th></th></tr>
          </thead>
          <tbody>
            <% tracks.forEach((track) => { %>
              <tr>
                <td><b><%= track.displayTitle %></b> <small style="color:var(--admin-muted)"><%= track.title %></small></td>
                <td><%= track.artistName %></td>
                <td><%= track.genre %></td>
                <td><%= track.duration %>с</td>
                <td><%= track.rating %></td>
                <td><%= track.album || '—' %></td>
                <td><%= track.releaseYear || '—' %></td>
                <td>
                  <form method="post" action="/admin/tracks/<%= track.id %>/delete" style="margin:0" onsubmit="return confirm('Удалить трек?')">
                    <button class="admin-button-danger" type="submit">Удалить</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <p style="color:var(--admin-muted)">Треков пока нет. Добавьте первый трек через форму выше.</p>
      <% } %>
    </div>
    <%- include('../../partials/admin-footer') %>
  </body>
</html>
