<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0e1014" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/assets/css/base.css" />
    <link rel="stylesheet" href="/assets/css/shared-layout.css" />
    <link rel="stylesheet" href="/assets/css/directory.css" />
    <link rel="stylesheet" href="/assets/css/player.css" />
    <script src="/assets/js/main.js" defer></script>
  </head>
  <body class="directory-page collections-page">
    <div class="app-shell">
      <%- include('../partials/sidebar', { currentPath: '/collections' }) %>
      <main class="main-area">
        <%- include('../partials/topbar', { searchLabel: 'Поиск по сайту', showMenuToggle: true }) %>
        <div class="content directory-content collections-content">
          <header class="directory-heading">
            <div>
              <h1>Подборки для тебя</h1>
              <p>
                Редакционные коллекции и рекомендации по твоим музыкальным
                вкусам.
              </p>
            </div>
          </header>
          <% const featuredCollection = collections.find((collection) => collection.featured); %>
          <% if (featuredCollection) { %>
          <section class="collection-feature" aria-label="Подборка недели">
            <div class="collection-feature-art">
              <span class="collection-feature-bars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span><strong><%= featuredCollection.tagline %></strong>
            </div>
            <div class="collection-feature-copy">
              <p class="eyebrow">ПОДБОРКА НЕДЕЛИ</p>
              <h2><%= featuredCollection.title %></h2>
              <p><%= featuredCollection.description %></p>
              <a class="button button-primary" href="/collections/<%= featuredCollection.id %>"
                >Посмотреть <%= featuredCollection.trackCount %> треков <span>↗</span></a
              >
            </div>
          </section>
          <% } %>
          <section class="collection-moods">
            <div class="directory-section-heading">
              <h2>Выбирай по настроению</h2>
              <a href="#recommendations" class="view-all"
                >Для тебя <span>↗</span></a
              >
            </div>
            <div class="collection-mood-grid">
              <% collections.filter((collection) => !collection.featured).forEach((collection) => { %>
                <a class="collection-mood-card <%= collection.cardClass %>" href="/collections/<%= collection.id %>">
                  <div class="collection-mood-art"><span class="collection-feature-bars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span><strong><%= collection.tagline %></strong></div>
                  <h3><%= collection.title %></h3>
                  <p><%= collection.description %> · <%= collection.trackCount %> трека</p>
                  <span class="collection-card-arrow">↗</span>
                </a>
              <% }) %>
            </div>
          </section>
          <%- include('../partials/footer', { footerClass: 'directory-footer', footerText: '© 2026 VoxSekai · Музыка начинается с тебя' }) %>
        </div>
      </main>
    </div>
    <%- include('../partials/mobile-nav', { currentPath: '/collections' }) %>
    <%- include('../partials/player') %>
  </body>
</html>
