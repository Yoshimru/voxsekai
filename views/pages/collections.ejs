<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0e1014" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/assets/css/main.css" />
    <script src="/assets/js/main.js" defer></script>
  </head>
  <body class="directory-page collections-page">
    <div class="app-shell">
      <%- include('../partials/sidebar', { currentPath: '/collections' }) %>
      <main class="main-area">
        <%- include('../partials/topbar', { searchLabel: 'Поиск по сайту', showMenuToggle: true }) %>
        <div class="content directory-content collections-content">
          <header class="directory-heading">
            <div>
              <h1>Подборки для тебя</h1>
              <p>
                Редакционные коллекции и рекомендации по твоим музыкальным
                вкусам.
              </p>
            </div>
          </header>
          <section class="collection-feature" aria-label="Подборка недели">
            <div class="collection-feature-art">
              <span class="collection-feature-bars">▥</span
              ><strong>AFTER HOURS</strong>
            </div>
            <div class="collection-feature-copy">
              <p class="eyebrow">ПОДБОРКА НЕДЕЛИ</p>
              <h2>После полуночи</h2>
              <p>
                Мягкий синтвейв и электро-поп для ночных поездок и тихих мыслей.
              </p>
              <a class="button button-primary" href="/catalog"
                >Посмотреть треки <span>↗</span></a
              >
            </div>
          </section>
          <section class="collection-moods">
            <div class="directory-section-heading">
              <h2>Выбирай по настроению</h2>
              <a href="#recommendations" class="view-all"
                >Для тебя <span>↗</span></a
              >
            </div>
            <div class="collection-mood-grid">
              <a
                class="collection-mood-card collection-mood-road"
                href="/catalog"
                ><div class="collection-mood-art">
                  <span class="collection-feature-bars">▥</span
                  ><strong>ДЛЯ ДОЛГОЙ ДОРОГИ</strong>
                </div>
                <h3>Для долгой дороги</h3>
                <p>74 трека · Ночной маршрут</p>
                <span class="collection-card-arrow">↗</span></a
              >
              <a
                class="collection-mood-card collection-mood-new"
                href="/catalog"
                ><div class="collection-mood-art">
                  <span class="collection-feature-bars">▥</span
                  ><strong>НОВЫЙ ЗВУК</strong>
                </div>
                <h3>Новый звук</h3>
                <p>Треки недели · 18 треков</p>
                <span class="collection-card-arrow">↗</span></a
              >
              <a
                class="collection-mood-card collection-mood-soft"
                href="/catalog"
                ><div class="collection-mood-art">
                  <span class="collection-feature-bars">▥</span
                  ><strong>МЯГКАЯ ЭНЕРГИЯ</strong>
                </div>
                <h3>Мягкая энергия</h3>
                <p>Для фокуса · 26 треков</p>
                <span class="collection-card-arrow">↗</span></a
              >
              <a
                class="collection-mood-card collection-mood-tokyo"
                href="/catalog"
                ><div class="collection-mood-art">
                  <span class="collection-feature-bars">▥</span
                  ><strong>ПОСЛЕ 22:00</strong>
                </div>
                <h3>Ночной Токио</h3>
                <p>После 22:00 · 42 трека</p>
                <span class="collection-card-arrow">↗</span></a
              >
            </div>
          </section>
          <section class="recommendation-banner" id="recommendations">
            <span class="recommendation-mark">✦</span>
            <div>
              <h2>Рекомендуем на основе твоих оценок</h2>
              <p>
                Ты высоко оценил 4 трека в жанре синтвейв — попробуй подборку
                «Холодный неон».
              </p>
            </div>
            <a class="button button-secondary" href="/catalog"
              >Посмотреть подборку <span>↗</span></a
            >
          </section>
          <%- include('../partials/footer', { footerClass: 'directory-footer', footerText: '© 2026 VoxSekai · Музыка начинается с тебя' }) %>
        </div>
      </main>
    </div>
    <%- include('../partials/mobile-nav', { currentPath: '/collections' }) %>
    <%- include('../partials/player') %>
  </body>
</html>
