<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0e1014" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/assets/css/main.css" />
    <script src="/assets/js/main.js" defer></script>
  </head>
  <body class="directory-page playlists-page">
    <div class="app-shell">
      <%- include('../partials/sidebar', { currentPath: '/playlists' }) %>
      <main class="main-area">
        <%- include('../partials/topbar', { searchLabel: 'Поиск по сайту', showMenuToggle: true }) %>
        <div class="content directory-content library-content">
          <header class="library-heading">
            <div>
              <h1>Мои плейлисты</h1>
              <p>Собирай музыку под настроение, момент или маршрут.</p>
            </div>
            <a class="button button-primary" href="/create-playlist"
              ><span>＋</span>Новый плейлист</a
            >
          </header>
          <section class="library-section">
            <div class="directory-section-heading">
              <h2>Твоя библиотека</h2>
              <span>6 плейлистов</span>
            </div>
            <div class="playlist-grid">
              <a
                class="playlist-card playlist-card-favorites"
                href="/favorites"
                ><div class="playlist-art">
                  <span class="playlist-bars"
                    ><i></i><i></i><i></i><i></i><i></i></span
                  ><strong>ИЗБРАННОЕ</strong>
                </div>
                <div class="playlist-card-info">
                  <h3>Избранное</h3>
                  <p>24 трека · недавно</p>
                  <span>↗</span>
                </div></a
              >
              <a class="playlist-card playlist-card-night" href="/playlist"
                ><div class="playlist-art">
                  <span class="playlist-bars"
                    ><i></i><i></i><i></i><i></i><i></i></span
                  ><strong>AFTER HOURS</strong>
                </div>
                <div class="playlist-card-info">
                  <h3>Ночной Токио</h3>
                  <p>18 треков · недавно</p>
                  <span>↗</span>
                </div></a
              >
              <a class="playlist-card playlist-card-repeat" href="/playlist"
                ><div class="playlist-art">
                  <span class="playlist-bars"
                    ><i></i><i></i><i></i><i></i><i></i></span
                  ><strong>ON REPEAT</strong>
                </div>
                <div class="playlist-card-info">
                  <h3>На повторе</h3>
                  <p>12 треков · недавно</p>
                  <span>↗</span>
                </div></a
              >
              <a
                class="playlist-card playlist-card-morning"
                href="/playlist"
                ><div class="playlist-art">
                  <span class="playlist-bars"
                    ><i></i><i></i><i></i><i></i><i></i></span
                  ><strong>SLOW START</strong>
                </div>
                <div class="playlist-card-info">
                  <h3>Медленное утро</h3>
                  <p>9 треков · недавно</p>
                  <span>↗</span>
                </div></a
              >
              <a class="playlist-card playlist-card-drive" href="/playlist"
                ><div class="playlist-art">
                  <span class="playlist-bars"
                    ><i></i><i></i><i></i><i></i><i></i></span
                  ><strong>ROAD MIX</strong>
                </div>
                <div class="playlist-card-info">
                  <h3>Дорога домой</h3>
                  <p>16 треков · недавно</p>
                  <span>↗</span>
                </div></a
              >
              <a class="playlist-card playlist-card-new" href="/playlist"
                ><div class="playlist-art">
                  <span class="playlist-bars"
                    ><i></i><i></i><i></i><i></i><i></i></span
                  ><strong>FRESH PICKS</strong>
                </div>
                <div class="playlist-card-info">
                  <h3>Новый звук</h3>
                  <p>7 треков · недавно</p>
                  <span>↗</span>
                </div></a
              >
            </div>
          </section>
          <section class="library-section recently-added">
            <div class="directory-section-heading">
              <h2>Недавно добавлено</h2>
              <a class="view-all" href="/catalog"
                >Все треки <span>↗</span></a
              >
            </div>
            <div class="recent-track-list">
              <article class="recent-track">
                <span class="recent-cover cover-pink">Gl<br />ass</span>
                <div>
                  <h3>Glass Horizon</h3>
                  <p>Mira Kai</p>
                </div>
                <span class="recent-duration">3:42</span><strong>★ 4.8</strong
                ><button
                  class="recent-add-button"
                  type="button"
                  data-playlist-add="Glass Horizon"
                  aria-label="Добавить Glass Horizon в плейлист"
                >
                  ＋
                </button>
              </article>
              <article class="recent-track">
                <span class="recent-cover cover-cyan">So<br />ft</span>
                <div>
                  <h3>Soft Reset</h3>
                  <p>Mira Kai</p>
                </div>
                <span class="recent-duration">2:58</span><strong>★ 4.8</strong
                ><button
                  class="recent-add-button"
                  type="button"
                  data-playlist-add="Soft Reset"
                  aria-label="Добавить Soft Reset в плейлист"
                >
                  ＋
                </button>
              </article>
              <article class="recent-track">
                <span class="recent-cover cover-violet">Ne<br />on</span>
                <div>
                  <h3>Neon Afterglow</h3>
                  <p>Mira Kai</p>
                </div>
                <span class="recent-duration">4:08</span><strong>★ 4.9</strong
                ><button
                  class="recent-add-button"
                  type="button"
                  data-playlist-add="Neon Afterglow"
                  aria-label="Добавить Neon Afterglow в плейлист"
                >
                  ＋
                </button>
              </article>
            </div>
          </section>
          <%- include('../partials/footer', { footerClass: 'directory-footer', footerText: '© 2026 VoxSekai · Музыка начинается с тебя' }) %>
        </div>
      </main>
    </div>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <%- include('../partials/mobile-nav', { currentPath: '/playlists' }) %>
  </body>
</html>
