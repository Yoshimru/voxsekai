<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0e1014" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/assets/css/base.css" />
    <link rel="stylesheet" href="/assets/css/shared-layout.css" />
    <link rel="stylesheet" href="/assets/css/directory.css" />
    <link rel="stylesheet" href="/assets/css/player.css" />
    <script src="/assets/js/main.js" defer></script>
  </head>
  <body class="directory-page artists-page">
    <div class="app-shell">
      <%- include('../partials/sidebar', { currentPath: '/artists' }) %>
      <main class="main-area">
        <%- include('../partials/topbar', { searchLabel: 'Поиск по сайту', showMenuToggle: true }) %>
        <div class="content directory-content artists-content">
          <section class="artists-hero" aria-label="Каталог исполнителей">
            <img src="https://images.unsplash.com/photo-1519608487953-e999c86e7455?auto=format&fit=crop&w=1800&q=85" alt="" />
            <div class="artists-hero-shade"></div>
            <div class="artists-hero-copy">
              <p class="directory-kicker">VOXSEKAI · КАТАЛОГ ИСПОЛНИТЕЛЕЙ</p>
              <h1>Голоса,<br />которые создают музыку</h1>
              <p>Виртуальные и электронные исполнители — от легенд вокалоидов до новых голосов.</p>
              <small><%= artists.length %> демо-профилей · <%= tracks.length %> треков в каталоге</small>
            </div>
          </section>
          <section class="artist-directory-controls" aria-label="Поиск исполнителей">
            <div class="artist-search-row">
              <label class="directory-search"><span aria-hidden="true">⌕</span><input id="page-search" type="search" placeholder="Имя исполнителя или жанр" aria-label="Поиск исполнителей" /></label>
              <button class="filter-control" type="button" data-filter-toggle aria-expanded="false" aria-controls="artist-genres" aria-label="Показать фильтры" title="Фильтры">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 5h16l-6.2 7.1v5.2l-3.6 1.8v-7z" /></svg>
              </button>
            </div>
            <div class="artist-filter-row">
              <div class="genre-filter artist-genre-filter" id="artist-genres" aria-label="Жанры исполнителей" hidden>
                <button class="genre-chip active" type="button" data-filter="all" aria-pressed="true">Все</button>
                <button class="genre-chip" type="button" data-filter="vocaloid" aria-pressed="false">Вокалоиды</button>
                <button class="genre-chip" type="button" data-filter="j-pop" aria-pressed="false">J-pop</button>
                <button class="genre-chip" type="button" data-filter="electronic" aria-pressed="false">Электроника</button>
                <button class="genre-chip" type="button" data-filter="synthwave" aria-pressed="false">Синтвейв</button>
                <button class="genre-chip" type="button" data-filter="rock" aria-pressed="false">Рок</button>
                <button class="genre-chip" type="button" data-filter="experimental" aria-pressed="false">Экспериментальные</button>
              </div>
              <label class="sort-control"><span class="sr-only">Сортировка</span><select id="artist-sort"><option value="popular">По популярности</option><option value="name">По имени</option><option value="tracks">По числу треков</option></select></label>
            </div>
            <p class="artist-results">Показано <strong data-results-count><%= artists.length %></strong> исполнителей</p>
          </section>
          <section class="performer-grid" data-sort-list aria-label="Исполнители">
            <% artists.forEach((artist) => { %>
              <a class="performer-card <%= artist.cardClass %>" href="/artists/<%= artist.id %>" data-genre-item data-genre="<%= artist.genres.join(' ') %>" data-search-text="<%= artist.searchText %>" data-tracks="<%= artist.trackCount %>">
                <div class="performer-art <%= artist.imageUrl ? 'has-photo' : '' %>">
                  <% if (artist.imageUrl) { %>
                    <img class="performer-photo" src="<%= artist.imageUrl %>" alt="<%= artist.name %>" loading="lazy" onerror="this.parentElement.classList.remove('has-photo');this.remove()" />
                  <% } %>
                  <span class="performer-bars"><i></i><i></i><i></i><i></i><i></i></span><b><%= artist.initials %></b>
                </div>
                <div class="performer-info">
                  <p><%= artist.genreLabel %></p><h2><%= artist.name %></h2>
                  <small><%= artist.alias %> · <%= artist.country %></small>
                  <span><%= artist.trackCount %> треков · <%= artist.listenersLabel %> слушателей</span>
                </div>
                <span class="performer-action">Слушать треки <b>↗</b></span>
              </a>
            <% }) %>
          </section>
          <p class="directory-empty" hidden>Исполнители не найдены.</p>
          <%- include('../partials/footer', { footerClass: 'directory-footer', footerText: '© 2026 VoxSekai · Музыка начинается с тебя' }) %>
        </div>
      </main>
    </div>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <%- include('../partials/mobile-nav', { currentPath: '/artists' }) %>
    <%- include('../partials/player') %>
  </body>
</html>
