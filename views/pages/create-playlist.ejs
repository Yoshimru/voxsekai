<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0e1014" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/assets/css/base.css" />
    <link rel="stylesheet" href="/assets/css/shared-layout.css" />
    <link rel="stylesheet" href="/assets/css/library.css" />
    <link rel="stylesheet" href="/assets/css/player.css" />
    <script src="/assets/js/main.js" defer></script>
  </head>
  <body class="directory-page playlist-editor-page">
    <div class="app-shell">
      <%- include('../partials/sidebar', { currentPath: '/create-playlist' }) %>
      <main class="main-area">
        <%- include('../partials/topbar', { searchLabel: 'Поиск по сайту' }) %>
        <div class="content directory-content playlist-editor-content">
          <%- include('../partials/playlist-seed', { playlists }) %>
          <header class="directory-heading">
            <div>
              <h1 data-playlist-form-title>Создать плейлист</h1>
              <p>Настрой название, обложку, описание и состав коллекции.</p>
            </div>
          </header>
          <form class="playlist-editor" data-playlist-form>
            <section class="playlist-editor-panel playlist-details-panel">
              <label class="editor-field"
                ><span>Название плейлиста <b>*</b></span
                ><input
                  id="playlist-name"
                  name="title"
                  type="text"
                  maxlength="48"
                  placeholder="Например, Ночной Токио"
                  required
              /></label>
              <label class="editor-field"
                ><span>Описание</span
                ><textarea
                  name="description"
                  rows="3"
                  placeholder="Музыка для поздних поездок и длинных прогулок..."
                ></textarea>
              </label>
              <div class="editor-field">
                <span>Обложка плейлиста</span>
                <p class="editor-hint">Цветовая обложка создаётся автоматически при сохранении плейлиста.</p>
              </div>
              <label class="public-toggle"
                ><span
                  ><strong>Публичный плейлист</strong
                  ><small
                    >Плейлист можно показывать другим пользователям.</small
                  ></span
                ><input type="checkbox" name="public" checked /><i
                  aria-hidden="true"
                ></i
              ></label>
              <p
                class="editor-message"
                data-playlist-message
                role="status"
                aria-live="polite"
              ></p>
              <div class="editor-actions">
                <button class="button button-primary" type="submit">
                  <span data-playlist-submit-label>Сохранить плейлист</span></button
                ><a class="button button-secondary" href="/playlists"
                  >Отмена</a
                >
              </div>
            </section>
            <section class="playlist-editor-panel add-tracks-panel">
              <div class="editor-panel-heading">
                <h2>Добавить треки</h2>
                <span data-selected-count aria-live="polite">0 выбрано</span>
              </div>
              <label class="directory-search"
                ><span aria-hidden="true">⌕</span
                ><input
                  type="search"
                  placeholder="Найти трек в каталоге..."
                  aria-label="Поиск треков для плейлиста"
                  data-track-search
              /></label>
              <div class="track-picker-columns">
                <section class="track-picker-column" aria-labelledby="available-tracks-heading">
                  <h3 class="track-picker-heading" id="available-tracks-heading">Каталог</h3>
                  <div class="available-tracks" data-available-tracks>
                    <% tracks.forEach((track, index) => { %>
                      <article class="available-track" data-track-id="<%= track.id %>" data-track-name="<%= track.displayTitle %>" data-track-order="<%= index %>">
                        <span class="available-cover <%= track.artworkClass %>"><%= track.artworkGlyph %></span>
                        <span><strong><%= track.displayTitle %></strong><small><%= track.artist %></small></span>
                        <button type="button" data-add-track="<%= track.id %>" aria-label="Добавить <%= track.displayTitle %>">＋</button>
                      </article>
                    <% }) %>
                  </div>
                </section>
                <section class="track-picker-column" aria-labelledby="selected-tracks-heading">
                  <h3 class="track-picker-heading" id="selected-tracks-heading">В плейлисте</h3>
                  <div class="selected-tracks" data-selected-track-list aria-live="polite"></div>
                  <p class="selected-tracks-empty" data-selected-empty>Добавленные треки появятся здесь.</p>
                </section>
              </div>
            </section>
          </form>
          <%- include('../partials/footer', { footerClass: 'directory-footer', footerText: '© 2026 VoxSekai · Музыка начинается с тебя' }) %>
        </div>
      </main>
    </div>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <%- include('../partials/mobile-nav', { currentPath: '/create-playlist' }) %>
    <%- include('../partials/player') %>
  </body>
</html>
