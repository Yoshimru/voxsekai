<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0e1014" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/assets/css/main.css" />
    <script src="/assets/js/main.js" defer></script>
  </head>
  <body class="directory-page playlist-editor-page">
    <div class="app-shell">
      <%- include('../partials/sidebar', { currentPath: '/create-playlist' }) %>
      <main class="main-area">
        <%- include('../partials/topbar', { searchLabel: 'Поиск по сайту', showMenuToggle: true }) %>
        <div class="content directory-content playlist-editor-content">
          <header class="directory-heading">
            <div>
              <h1>Создать плейлист</h1>
              <p>Настрой название, обложку, описание и состав коллекции.</p>
            </div>
          </header>
          <form class="playlist-editor" data-playlist-form>
            <section class="playlist-editor-panel playlist-details-panel">
              <label class="editor-field"
                ><span>Название плейлиста <b>*</b></span
                ><input
                  id="playlist-name"
                  name="title"
                  type="text"
                  maxlength="48"
                  placeholder="Например, Ночной Токио"
                  required
              /></label>
              <label class="editor-field"
                ><span>Описание</span
                ><textarea
                  name="description"
                  rows="3"
                  placeholder="Музыка для поздних поездок и длинных прогулок..."
                ></textarea>
              </label>
              <div class="editor-field">
                <span>Обложка плейлиста</span
                ><label class="cover-upload"
                  ><input
                    type="file"
                    accept="image/png,image/jpeg,image/webp"
                    data-cover-input
                  /><span class="upload-plus">＋</span
                  ><span>Перетащи изображение или выбери файл</span
                  ><small data-cover-hint
                    >JPG, PNG, WEBP · до 5 МБ</small
                  ></label
                >
              </div>
              <label class="public-toggle"
                ><span
                  ><strong>Публичный плейлист</strong
                  ><small
                    >Плейлист можно показывать другим пользователям.</small
                  ></span
                ><input type="checkbox" name="public" checked /><i
                  aria-hidden="true"
                ></i
              ></label>
              <p
                class="editor-message"
                data-playlist-message
                role="status"
                aria-live="polite"
              ></p>
              <div class="editor-actions">
                <button class="button button-primary" type="submit">
                  Сохранить плейлист</button
                ><a class="button button-secondary" href="/playlists"
                  >Отмена</a
                >
              </div>
            </section>
            <section class="playlist-editor-panel add-tracks-panel">
              <div class="editor-panel-heading">
                <h2>Добавить треки</h2>
                <span data-selected-count>0 выбрано</span>
              </div>
              <label class="directory-search"
                ><span aria-hidden="true">⌕</span
                ><input
                  type="search"
                  placeholder="Найти трек в каталоге..."
                  aria-label="Поиск треков для плейлиста"
                  data-track-search
              /></label>
              <div class="available-tracks">
                <article
                  class="available-track"
                  data-track-name="Neon Afterglow"
                >
                  <span class="available-cover cover-cyan">Ne<br />on</span
                  ><span
                    ><strong>Neon Afterglow</strong
                    ><small>Mira Kai</small></span
                  ><button
                    type="button"
                    data-add-track="Neon Afterglow"
                    aria-label="Добавить Neon Afterglow"
                  >
                    ＋
                  </button>
                </article>
                <article
                  class="available-track"
                  data-track-name="Synthetic Bloom"
                >
                  <span class="available-cover cover-violet">Sy<br />nth</span
                  ><span
                    ><strong>Synthetic Bloom</strong
                    ><small>Mira Kai</small></span
                  ><button
                    type="button"
                    data-add-track="Synthetic Bloom"
                    aria-label="Добавить Synthetic Bloom"
                  >
                    ＋
                  </button>
                </article>
                <article class="available-track" data-track-name="Blue Signal">
                  <span class="available-cover cover-pink">Blue<br />Sign</span
                  ><span><strong>Blue Signal</strong><small>KAIRO</small></span
                  ><button
                    type="button"
                    data-add-track="Blue Signal"
                    aria-label="Добавить Blue Signal"
                  >
                    ＋
                  </button>
                </article>
                <article class="available-track" data-track-name="Plastic Moon">
                  <span class="available-cover cover-orange"
                    >Plastic<br />Moon</span
                  ><span
                    ><strong>Plastic Moon</strong><small>Yuna 404</small></span
                  ><button
                    type="button"
                    data-add-track="Plastic Moon"
                    aria-label="Добавить Plastic Moon"
                  >
                    ＋
                  </button>
                </article>
                <article
                  class="available-track"
                  data-track-name="Glass Horizon"
                >
                  <span class="available-cover cover-cyan"
                    >Glass<br />Horizon</span
                  ><span
                    ><strong>Glass Horizon</strong><small>Mira Kai</small></span
                  ><button
                    type="button"
                    data-add-track="Glass Horizon"
                    aria-label="Добавить Glass Horizon"
                  >
                    ＋
                  </button>
                </article>
              </div>
              <p class="selected-track-note" data-selected-tracks>
                Выбери треки, которые войдут в плейлист.
              </p>
            </section>
          </form>
          <%- include('../partials/footer', { footerClass: 'directory-footer', footerText: '© 2026 VoxSekai · Музыка начинается с тебя' }) %>
        </div>
      </main>
    </div>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <%- include('../partials/mobile-nav', { currentPath: '/create-playlist' }) %>
  </body>
</html>
