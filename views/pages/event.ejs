<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0e1014" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/assets/css/base.css" />
    <link rel="stylesheet" href="/assets/css/shared-layout.css" />
    <link rel="stylesheet" href="/assets/css/directory.css" />
    <link rel="stylesheet" href="/assets/css/events.css" />
    <link rel="stylesheet" href="/assets/css/player.css" />
    <script src="/assets/js/main.js" defer></script>
  </head>
  <body class="directory-page event-detail-page">
    <div class="app-shell">
      <%- include('../partials/sidebar', { currentPath: '/events' }) %>
      <main class="main-area">
        <%- include('../partials/topbar', { searchLabel: 'Поиск по сайту', showMenuToggle: true }) %>
        <div class="content directory-content event-detail-content">
          <a class="event-back-link" href="/events">← Все события</a>
          <article class="event-detail <%= event.artworkClass %>">
            <div class="event-detail-art"><span><%= event.tag %></span><b><%= event.artworkGlyph %></b></div>
            <div class="event-detail-copy">
              <p class="directory-kicker"><%= event.category.toLocaleUpperCase('ru') %> · <%= event.location.toLocaleUpperCase('ru') %></p>
              <h1><%= event.title %></h1><p class="event-detail-description"><%= event.description %></p>
              <dl class="event-detail-facts">
                <div><dt>Дата</dt><dd><%= event.dateLabel %></dd></div>
                <div><dt>Начало</dt><dd><%= event.time %></dd></div>
                <div><dt>Место</dt><dd><%= event.venue %></dd></div>
                <div><dt>Формат</dt><dd><%= event.type === 'online' ? 'Онлайн' : 'Офлайн' %></dd></div>
              </dl>
              <a class="button button-primary" href="/events">Вернуться к событиям <span>↗</span></a>
            </div>
          </article>
          <%- include('../partials/footer', { footerClass: 'directory-footer', footerText: '© 2026 VoxSekai · Музыка начинается с тебя' }) %>
        </div>
      </main>
    </div>
    <%- include('../partials/mobile-nav', { currentPath: '/events' }) %>
    <%- include('../partials/player') %>
  </body>
</html>
