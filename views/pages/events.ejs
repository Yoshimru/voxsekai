<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0e1014" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/assets/css/base.css" />
    <link rel="stylesheet" href="/assets/css/shared-layout.css" />
    <link rel="stylesheet" href="/assets/css/directory.css" />
    <link rel="stylesheet" href="/assets/css/events.css" />
    <link rel="stylesheet" href="/assets/css/player.css" />
    <script src="/assets/js/main.js" defer></script>
  </head>
  <body class="directory-page events-page">
    <div class="app-shell">
      <%- include('../partials/sidebar', { currentPath: '/events' }) %>
      <main class="main-area">
        <%- include('../partials/topbar', { searchLabel: 'Поиск по сайту', showMenuToggle: true }) %>
        <div class="content directory-content events-content">
          <header class="directory-heading"><div><p class="directory-kicker">MEET / 01</p><h1>События VoxSekai</h1><p>Встречай любимые голоса онлайн и за пределами наушников.</p></div></header>
          <% const featuredEvent = events[0]; %>
          <% if (featuredEvent) { %>
            <section class="events-feature" aria-label="Ближайшее событие">
              <img src="https://images.unsplash.com/photo-1506157786151-b8491531f063?auto=format&fit=crop&w=1600&q=85" alt="" />
              <div class="events-feature-shade"></div>
              <div class="events-feature-copy">
                <p class="directory-kicker">СЛЕДУЮЩЕЕ СОБЫТИЕ · <%= featuredEvent.dateLabel.toLocaleUpperCase('ru') %></p>
                <h2><%= featuredEvent.title %></h2><p><%= featuredEvent.description %></p>
                <a class="button button-primary" href="/events/<%= featuredEvent.id %>">Подробнее о событии <span>↗</span></a>
              </div>
              <span class="events-feature-date"><b><%= featuredEvent.day %></b><small><%= featuredEvent.month %></small></span>
            </section>
          <% } %>
          <section class="events-controls" aria-label="Поиск и фильтр событий">
            <label class="directory-search"><span aria-hidden="true">⌕</span><input id="page-search" type="search" placeholder="Название события, город или исполнитель" aria-label="Поиск событий" /></label>
            <div class="genre-filter" aria-label="Тип события">
              <button class="genre-chip active" type="button" data-filter="all" aria-pressed="true">Все события</button>
              <button class="genre-chip" type="button" data-filter="online" aria-pressed="false">Онлайн</button>
              <button class="genre-chip" type="button" data-filter="offline" aria-pressed="false">Офлайн</button>
            </div>
          </section>
          <section class="events-list" id="upcoming-events">
            <div class="directory-section-heading"><h2>Скоро</h2><p><span data-results-count><%= events.length %></span> событий</p></div>
            <div class="event-card-grid" data-sort-list>
              <% events.forEach((event) => { %>
                <article class="event-card <%= event.artworkClass %>" data-genre-item data-genre="<%= event.type %>" data-search-text="<%= `${event.title} ${event.location} ${event.venue} ${event.category}`.toLocaleLowerCase('ru') %>">
                  <div class="event-card-art"><span><%= event.tag %></span><b><%= event.artworkGlyph %></b></div>
                  <div class="event-card-info">
                    <p><%= event.location.toLocaleUpperCase('ru') %> · <%= event.dateLabel.toLocaleUpperCase('ru') %></p>
                    <h3><%= event.title %></h3><span>Начало в <%= event.time %> · <%= event.venue %></span>
                  </div>
                  <a class="event-card-action" href="/events/<%= event.id %>">Подробнее <b>↗</b></a>
                </article>
              <% }) %>
            </div>
            <p class="directory-empty" hidden>События не найдены.</p>
          </section>
          <%- include('../partials/footer', { footerClass: 'directory-footer', footerText: '© 2026 VoxSekai · Музыка начинается с тебя' }) %>
        </div>
      </main>
    </div>
    <%- include('../partials/mobile-nav', { currentPath: '/events' }) %>
    <%- include('../partials/player') %>
  </body>
</html>
